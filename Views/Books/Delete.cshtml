@model Book 
@{
	ViewData["Title"] = "Delete Details";
}
<h1> Delete Details</h1>
<h3>Are you sure to DELETE this	BOOK!!!</h3>
<hr />

<div>
	<dl class="row">
		<dt class="col-sm-2"> @Html.DisplayNameFor(m=>m.Title)</dt>
		<dd class="col-sm-10"> @Html.DisplayFor(m=>m.Title)</dd>

		<dt class="col-sm-2"> @Html.DisplayNameFor(m=>m.Author)</dt>
		<dd class="col-sm-10"> @Html.DisplayFor(m=>m.Author)</dd>

		<dt class="col-sm-2"> @Html.DisplayNameFor(m=>m.price)</dt>
		<dd class="col-sm-10"> @Html.DisplayFor(m=>m.price)</dd>

		<dt class="col-sm-2"> @Html.DisplayNameFor(m=>m.quantity)</dt>
		<dd class="col-sm-10"> @Html.DisplayFor(m=>m.quantity)</dd>
	</dl>

	<form asp-action="Delete">
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="Id" />
		<button type="Submit" class="btn btn-danger"><i class="bi bi-trash"></i>Delete</button>

		<a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-circle"></i>Back to List</a>

	</form>

</div>
